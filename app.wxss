/* 清风循迹 · 全局样式：以"朱砂红 + 宣纸米 + 墨色"为主色，贴合廉洁文化气质 */

page {
  --c-primary: #8C1F28;      /* 朱砂红 */
  --c-primary-soft: #B8434D;
  --c-gold: #B8860B;         /* 描金 */
  --c-ink: #2B2B2B;          /* 墨色 */
  --c-ink-2: #5A5A5A;
  --c-ink-3: #8A8A8A;
  --c-paper: #F5F1E8;        /* 宣纸米 */
  --c-card: #FFFFFF;
  --c-line: #EAE3D6;

  background: var(--c-paper);
  color: var(--c-ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

view,
text,
scroll-view,
button,
input {
  box-sizing: border-box;
}

.card {
  background: var(--c-card);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(140, 31, 40, 0.06);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: #F7EDEC;
  color: var(--c-primary);
  border: 1rpx solid #EFD9DA;
}

.tag--gold {
  background: #FBF5E4;
  color: var(--c-gold);
  border-color: #F0E3C2;
}

.tag--ink {
  background: #F2F2F2;
  color: var(--c-ink-2);
  border-color: #E6E6E6;
}

.hairline {
  height: 1rpx;
  background: var(--c-line);
}

.muted {
  color: var(--c-ink-3);
  font-size: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-ink);
  margin: 32rpx 0 16rpx;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--c-primary), var(--c-gold));
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ellipsis-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.safe-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
