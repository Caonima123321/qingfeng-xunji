.page {
  min-height: 100vh;
  background: #F5F1E8;
}

.hero {
  padding: 60rpx 40rpx 70rpx;
  background: linear-gradient(150deg, #8C1F28, #B8434D 60%, #B8860B);
  color: #fff;
}

.hero__title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.hero__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  opacity: 0.9;
  letter-spacing: 2rpx;
}

.hero__desc {
  display: block;
  margin-top: 26rpx;
  font-size: 25rpx;
  line-height: 1.85;
  opacity: 0.94;
  text-align: justify;
}

/* ---------- 数据概览 ---------- */
.stats {
  display: flex;
  margin: -40rpx 24rpx 0;
  padding: 26rpx 0;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 26rpx rgba(140, 31, 40, 0.1);
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #F2EEE4;
}

.stat:last-child {
  border-right: none;
}

.stat__n {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #8C1F28;
  line-height: 1.2;
}

.stat__t {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8A8A8A;
}

.content {
  padding: 8rpx 24rpx 0;
}

.block {
  padding: 26rpx 28rpx;
}

.block--plain {
  padding: 10rpx 28rpx;
}

.paragraph {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #3A3A3A;
  text-align: justify;
}

/* ---------- 分类 ---------- */
.cat {
  display: flex;
  padding: 16rpx 0;
}

.cat__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin: 10rpx 18rpx 0 0;
  flex: none;
}

.cat__body {
  flex: 1;
}

.cat__name {
  display: block;
  font-size: 27rpx;
  color: #2B2B2B;
  font-weight: 600;
}

.cat__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7A7A7A;
  line-height: 1.6;
}

/* ---------- 序号条目 ---------- */
.point {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.point__no {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin: 4rpx 18rpx 0 0;
  border-radius: 50%;
  background: #F7EDEC;
  color: #8C1F28;
  font-size: 22rpx;
  text-align: center;
  line-height: 40rpx;
}

.point__txt {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #3A3A3A;
}

/* ---------- 官方名单 ---------- */
.oflist {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F4F0E7;
}

.oflist:last-child {
  border-bottom: none;
}

.oflist__city {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #8C1F28;
}

.oflist__names {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #4A4A4A;
  line-height: 1.6;
}

.note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F4F0E7;
  font-size: 22rpx;
  line-height: 1.75;
  color: #968E80;
}

/* ---------- 联系 ---------- */
.contact {
  display: flex;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F4F0E7;
}

.contact__k {
  flex: none;
  width: 150rpx;
  font-size: 25rpx;
  color: #8A8A8A;
}

.contact__v {
  flex: 1;
  font-size: 25rpx;
  color: #2B2B2B;
  line-height: 1.6;
}

.footer {
  margin-top: 50rpx;
  text-align: center;
  font-size: 22rpx;
  color: #A9A192;
  line-height: 2;
}
