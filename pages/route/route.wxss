/* ================= 研学路线（小地图） ================= */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F5F1E8;
}

.rmap {
  flex: none;
  width: 100%;
  height: 38vh;
}

.rbody {
  flex: 1;
  min-height: 0;
  padding: 26rpx 28rpx 0;
}

.rhead__title {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #2B2B2B;
}

.rhead__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A8A8A;
}

.rtabs {
  margin-top: 22rpx;
  white-space: nowrap;
}

.rtab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border: 1rpx solid #EAE3D6;
  border-radius: 40rpx;
  background: #fff;
  font-size: 24rpx;
  color: #5A5A5A;
}

.rtab--on {
  background: #8C1F28;
  border-color: #8C1F28;
  color: #fff;
}

.rintro {
  display: block;
  margin-top: 26rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #3A3A3A;
  text-align: justify;
}

.rs-title {
  display: flex;
  align-items: center;
  margin: 34rpx 4rpx 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2B2B2B;
}

.rs-title::before {
  content: '';
  width: 10rpx;
  height: 32rpx;
  margin-right: 18rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #8C1F28, #D9B44A);
}

.rlist {
  padding: 0 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(140, 31, 40, 0.05);
}

.ritem {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F4F0E7;
}

.ritem:last-child {
  border-bottom: none;
}

.rno {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #8C1F28;
  color: #fff;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
}

.rmid {
  flex: 1;
  min-width: 0;
}

.rname {
  display: block;
  font-size: 27rpx;
  color: #2B2B2B;
}

.rmeta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A29A8C;
}

.rleg {
  flex: none;
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #8C1F28;
}

.rgo {
  flex: none;
  margin-left: 10rpx;
  font-size: 32rpx;
  color: #C9C1B2;
}

.ronmap {
  margin-top: 32rpx;
  padding: 28rpx 0;
  border-radius: 26rpx;
  background: #F7EDEC;
  color: #8C1F28;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.rnote {
  display: block;
  margin: 24rpx 4rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  color: #A29A8C;
}
