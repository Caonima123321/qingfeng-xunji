/* ================= 地图主页 ================= */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #F5F1E8;
}

.map {
  width: 100%;
  height: 100%;
}

/* ---------- 顶部搜索与操作 ---------- */
.topbar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  display: flex;
  align-items: flex-start;
  z-index: 30;
}

.search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 26rpx;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.1);
}

.search__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search__ph {
  font-size: 26rpx;
  color: #9A9A9A;
}

.fab-col {
  flex: none;
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.fab {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.fab__icon {
  font-size: 32rpx;
  line-height: 1;
  color: #2F80ED;
}

.fab__txt {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5A5A5A;
}

.fab--home .fab__icon {
  font-size: 28rpx;
}

/* ---------- 分类 chips ---------- */
.chips {
  position: absolute;
  left: 0;
  right: 0;
  top: 124rpx;
  height: 76rpx;
  white-space: nowrap;
  z-index: 29;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin-left: 20rpx;
  background: #fff;
  border: 1rpx solid #EAE3D6;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5A5A5A;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
}

.chip:first-child {
  margin-left: 24rpx;
}

.chip--on {
  color: #fff;
  background: #8C1F28;
  border-color: #8C1F28;
}

.chip--reset {
  color: #8C1F28;
  border-color: #EFD9DA;
}

.chip__n {
  margin-left: 10rpx;
  font-size: 20rpx;
  opacity: 0.75;
}

/* ---------- 图例（内嵌面板） ---------- */
.legend {
  margin: 0 24rpx 14rpx;
  padding: 8rpx 22rpx 14rpx;
  background: #fff;
  border: 1rpx solid #EAE3D6;
  border-radius: 16rpx;
  max-height: 320rpx;
  overflow: hidden;
}

.legend__row {
  display: flex;
  padding: 10rpx 0;
}

.legend__dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin: 8rpx 14rpx 0 0;
  flex: none;
}

.legend__info {
  flex: 1;
  min-width: 0;
}

.legend__name {
  display: block;
  font-size: 23rpx;
  color: #2B2B2B;
}

.legend__desc {
  display: block;
  font-size: 21rpx;
  color: #8A8A8A;
  line-height: 1.45;
}

/* ---------- 底部面板 ---------- */
.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 700rpx;
  background: #F5F1E8;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 30rpx rgba(0, 0, 0, 0.12);
  z-index: 31;
  transition: transform 0.26s ease;
  display: flex;
  flex-direction: column;
}

.sheet--down {
  transform: translateY(620rpx);
}

.sheet__handle {
  padding: 14rpx 0 4rpx;
  display: flex;
  justify-content: center;
}

.sheet__grip {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #D8CFBE;
}

.sheet__head {
  display: flex;
  align-items: baseline;
  padding: 8rpx 28rpx 12rpx;
}

.sheet__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2B2B;
}

.sheet__count {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #8C1F28;
}

.sheet__tip {
  margin-left: auto;
  font-size: 22rpx;
  color: #B8860B;
}

.sheet__legend {
  margin-left: 18rpx;
  font-size: 22rpx;
  color: #8C1F28;
}

.sheet__list {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.sheet__item {
  display: block;
  margin-bottom: 18rpx;
}

.empty {
  padding: 90rpx 0;
  text-align: center;
  color: #8A8A8A;
  font-size: 26rpx;
}

.empty__op {
  display: block;
  margin-top: 20rpx;
  color: #8C1F28;
  font-size: 26rpx;
}

/* ---------- 市州面板 ---------- */
.mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 40;
}

.citypanel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  z-index: 41;
  transform: translateY(101%);
  transition: transform 0.28s ease;
  display: flex;
  flex-direction: column;
}

.citypanel--open {
  transform: translateY(0);
}

.citypanel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 30rpx 10rpx;
}

.citypanel__title {
  font-size: 32rpx;
  font-weight: 600;
}

.citypanel__close {
  font-size: 30rpx;
  color: #8A8A8A;
  padding: 0 10rpx;
}

.citypanel__body {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
}

.citygrid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.citygrid__item {
  width: 31.5%;
  margin-bottom: 18rpx;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: #F7F4ED;
  border: 1rpx solid #EFE9DC;
  text-align: center;
}

.citygrid__item--on {
  background: #F7EDEC;
  border-color: #8C1F28;
}

.citygrid__name {
  display: block;
  font-size: 25rpx;
  color: #2B2B2B;
}

.citygrid__item--on .citygrid__name {
  color: #8C1F28;
  font-weight: 600;
}

.citygrid__n {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A8A8A;
}

.citypanel__home {
  margin: 16rpx 0 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #8C1F28, #B8434D);
  color: #fff;
}

.citypanel__home-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.citypanel__home-d {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.88;
  line-height: 1.5;
}
